# Application
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=clothes
QDRANT_COMMERCE_COLLECTION_NAME=commerce
QDRANT_USE_HTTPS=false
QDRANT_PREFER_GRPC=false

# Redis (AI Service)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=10


# HuggingFace
HF_HOME=./models
HF_TOKEN=

# Models
UPSTAGE_API_KEY=your_upstage_api_key_here
EMBEDDING_MODEL=solar-embedding-1-large-passage
CAPTION_MODEL=Salesforce/blip-image-captioning-base
OPENAI_API_KEY=your_api_key_here
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash
VTON_MODEL=gemini-3-pro-image-preview

# Naver Shopping API
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# AI Server (GCP)
GCP_SERVER_URL=http://your_gcp_server_ip:8000

USE_MOCK_ANALYZER=false
