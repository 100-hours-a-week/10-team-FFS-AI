# Application
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=clothes
QDRANT_SHOP_COLLECTION_NAME=commerce
QDRANT_USE_HTTPS=false
QDRANT_PREFER_GRPC=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=admin
REDIS_MAX_CONNECTIONS=50

# HuggingFace & Local Models
HF_HOME=./models
HF_TOKEN=

# LLM & Embedding Models
UPSTAGE_API_KEY=your_upstage_api_key_here
EMBEDDING_MODEL=embedding-passage

# OpenAI
OPENAI_API_KEY=your_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
LLM_MAX_RETRIES=3

# Gemini
GEMINI_API_KEY=your_genimi_api_key_here
GEMINI_MODEL=gemini-2.5-flash
VTON_MODEL=gemini-3-pro-image-preview
VTON_FALLBACK_MODEL=gemini-2.5-flash-image

# Naver Shopping API
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# Testing/Mocking
USE_MOCK_ANALYZER=false

# AI Servers (GCP Instances)
VLLM_SERVER_URL=http://localhost:8001
VLLM_MODEL_NAME=RedHatAI/gemma-3-12b-it-quantized.w8a8
RAY_SERVER_URL=http://localhost:8000

# Langfuse (LLM Observability)
LANGFUSE_ENABLED=true
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_HOST=http://localhost:3001

# Kafka Settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ANALYZE_CONSUMER_GROUP=ai_clothes_analyze_worker_group
KAFKA_MAX_CONCURRENT_TASKS=20

# Backend Internal API (for presigned URLs)
BACKEND_INTERNAL_URL=http://your_backend_internal_ip
BACKEND_INTERNAL_API_KEY=your_api_key_here
